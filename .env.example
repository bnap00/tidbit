# Copy to .env. With no provider configured the brain uses ScriptedBrain (offline, rule-based).

# --- Pick ONE provider -------------------------------------------------------------

# ChatGPT Plus/Pro subscription via OAuth (no API key): run `pnpm login openai-codex` once.
# PAL_PROVIDER=openai-codex
# PAL_MODEL=gpt-5.5

# Anthropic
# PAL_PROVIDER=anthropic
# PAL_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=

# OpenAI
# PAL_PROVIDER=openai
# PAL_MODEL=gpt-5-mini
# OPENAI_API_KEY=

# Google
# PAL_PROVIDER=google
# PAL_MODEL=gemini-3.5-flash
# GEMINI_API_KEY=

# Groq
# PAL_PROVIDER=groq
# PAL_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=

# Any OpenAI-compatible server (Ollama, LM Studio, vLLM). PAL_API_KEY only if it needs one.
# PAL_BASE_URL=http://127.0.0.1:11434/v1
# PAL_MODEL=llama3.2
# PAL_API_KEY=

# --- Optional ----------------------------------------------------------------------
# PAL_THINKING=low            # off | minimal | low | medium | high
# PAL_PORT=18790
# PAL_HOST=127.0.0.1          # anything else requires PAL_TOKEN
# PAL_TOKEN=
# PAL_AUTH_FILE=./auth.json   # OAuth credentials from `pnpm login`

# --- Skills and actions ---------------------------------------------------------------
# web_search is offered only when one of these is set (Brave wins if both are).
# PAL_BRAVE_API_KEY=
# PAL_SEARXNG_URL=http://127.0.0.1:8888   # a SearXNG instance with JSON output enabled
# Let owner-defined HTTP actions reach LAN/Tailscale hosts such as Home Assistant.
# This machine (loopback) is always refused.
# PAL_ALLOW_PRIVATE_ACTIONS=1

# --- Devices (ESP32 pal, see docs/DEVICE.md) ---------------------------------------
# Speech-to-text for audio captures and questions: any OpenAI-compatible
# /v1/audio/transcriptions server. Local and free: faster-whisper-server / speaches
#   docker run -p 8000:8000 ghcr.io/speaches-ai/speaches:latest-cpu
# PAL_STT_URL=http://127.0.0.1:8000/v1
# PAL_STT_MODEL=Systran/faster-whisper-small
# PAL_STT_KEY=
# Text-to-speech so the device speaks in the pal's own Kokoro voice: any
# OpenAI-compatible /v1/audio/speech server, e.g. Kokoro-FastAPI
#   docker run -p 8880:8880 ghcr.io/remsky/kokoro-fastapi-cpu:latest
# PAL_TTS_URL=http://127.0.0.1:8880/v1
# PAL_TTS_MODEL=kokoro
# PAL_TTS_KEY=
