{
  "type": "object",
  "required": [
    "name",
    "look",
    "temper",
    "baseMood",
    "persona",
    "voice"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Short name, at most 16 characters."
    },
    "look": {
      "type": "object",
      "required": [
        "body",
        "size",
        "plump",
        "eyes",
        "eyeSize",
        "eyeGap",
        "brows",
        "mouth",
        "ears",
        "limbs",
        "tail",
        "marking",
        "accessory",
        "hue",
        "scheme"
      ],
      "properties": {
        "body": {
          "type": "string",
          "enum": [
            "blob",
            "round",
            "tall",
            "squat",
            "bean",
            "ghost",
            "egg",
            "square"
          ],
          "description": "Overall body silhouette."
        },
        "size": {
          "type": "integer",
          "description": "0-9. Overall scale."
        },
        "plump": {
          "type": "integer",
          "description": "0-9. 0 = slim and tall, 9 = wide and round."
        },
        "eyes": {
          "type": "string",
          "enum": [
            "dot",
            "round",
            "oval",
            "tall",
            "sleepy",
            "sparkle",
            "cyclops",
            "visor"
          ],
          "description": "Eye style."
        },
        "eyeSize": {
          "type": "integer",
          "description": "0-9. Eye size."
        },
        "eyeGap": {
          "type": "integer",
          "description": "0-9. Distance between the eyes."
        },
        "brows": {
          "type": "string",
          "enum": [
            "none",
            "thin",
            "thick"
          ],
          "description": "Eyebrows."
        },
        "mouth": {
          "type": "string",
          "enum": [
            "smile",
            "cat",
            "beak",
            "fang",
            "line",
            "o"
          ],
          "description": "Mouth style."
        },
        "ears": {
          "type": "string",
          "enum": [
            "none",
            "cat",
            "bunny",
            "bear",
            "horn",
            "antenna",
            "fin",
            "leaf"
          ],
          "description": "Ears or head feature."
        },
        "limbs": {
          "type": "string",
          "enum": [
            "none",
            "nubs",
            "arms",
            "wings",
            "tentacles",
            "paws"
          ],
          "description": "Arms or equivalent."
        },
        "tail": {
          "type": "string",
          "enum": [
            "none",
            "cat",
            "puff",
            "devil",
            "fish",
            "leaf"
          ],
          "description": "Tail."
        },
        "marking": {
          "type": "string",
          "enum": [
            "none",
            "belly",
            "spots",
            "stripes",
            "mask",
            "freckles"
          ],
          "description": "Body pattern."
        },
        "accessory": {
          "type": "string",
          "enum": [
            "none",
            "bow",
            "hat",
            "glasses",
            "scarf",
            "halo",
            "flower",
            "crown"
          ],
          "description": "Worn accessory."
        },
        "hue": {
          "type": "integer",
          "description": "0-359. Main colour hue in degrees (0 red, 120 green, 240 blue)."
        },
        "scheme": {
          "type": "string",
          "enum": [
            "mono",
            "analogous",
            "complement",
            "triad",
            "pastel",
            "neon",
            "earth"
          ],
          "description": "How the other colours relate to the main hue."
        }
      },
      "additionalProperties": false
    },
    "temper": {
      "type": "object",
      "required": [
        "energy",
        "playful",
        "shy",
        "grumpy",
        "curious"
      ],
      "properties": {
        "energy": {
          "type": "integer",
          "description": "0-9. How lively."
        },
        "playful": {
          "type": "integer",
          "description": "0-9. How playful."
        },
        "shy": {
          "type": "integer",
          "description": "0-9. How shy."
        },
        "grumpy": {
          "type": "integer",
          "description": "0-9. How grumpy."
        },
        "curious": {
          "type": "integer",
          "description": "0-9. How curious."
        }
      },
      "additionalProperties": false
    },
    "baseMood": {
      "type": "string",
      "enum": [
        "neutral",
        "happy",
        "excited",
        "sad",
        "angry",
        "scared",
        "surprised",
        "sleepy",
        "curious",
        "love",
        "confused",
        "proud"
      ],
      "description": "Resting mood."
    },
    "persona": {
      "type": "string",
      "description": "One or two sentences describing the personality, at most 240 characters."
    },
    "voice": {
      "type": "object",
      "required": [
        "pitch",
        "speed",
        "timbre"
      ],
      "properties": {
        "pitch": {
          "type": "integer",
          "description": "0-9. Voice pitch."
        },
        "speed": {
          "type": "integer",
          "description": "0-9. Speaking speed."
        },
        "timbre": {
          "type": "string",
          "enum": [
            "warm",
            "bubbly",
            "soft",
            "calm",
            "bright",
            "posh",
            "gent",
            "storyteller",
            "buddy",
            "gruff",
            "impish"
          ],
          "description": "Voice character that fits the personality: warm = friendly, caring young woman; bubbly = excitable, energetic girl; soft = hushed, breathy whisper (shy or sleepy); calm = gentle, soothing woman; bright = clear, confident woman; posh = polite, proper British woman; gent = dignified older British man; storyteller = whimsical British narrator; buddy = easygoing, friendly young man; gruff = deep, rough, grumbly man; impish = cheeky, playful young man."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
